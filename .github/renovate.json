{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["helpers:pinGitHubActionDigests"],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": ["dependencies", "no-stale"],
  "assigneesFromCodeOwners": true,
  "commitMessagePrefix": "⬆️",
  "commitMessageTopic": "{{depName}}",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/", "//build.yaml$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ARG BUILD_FROM=(?<depName>.*?):(?<currentValue>.*?)\\s+",
        "(aarch64|amd64):\\s[\"']?(?<depName>.*?):(?<currentValue>.*?)[\"']?\\s"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "matchStrings": [
        "ENV XCADDY_VERSION=[\"']?(?<currentValue>v[\\d.]+)[\"']?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "caddyserver/xcaddy"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "matchStrings": [
        "ENV CADDY_VERSION=[\"']?(?<currentValue>v[\\d.]+)[\"']?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "caddyserver/caddy"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "(?:^|\r\n|\r|\n|$)\\s+(?<packageName>[a-z0-9-]+)=(?<currentValue>[a-z0-9-_.]+)\\s*"
      ],
      "versioningTemplate": "loose",
      "datasourceTemplate": "apk"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["apk"],
      "automerge": true,
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64",
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=aarch64"
      ]
    },
    {
      "groupName": "App base image",
      "matchDatasources": ["docker"]
    },
    {
      "groupName": "App base image",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
