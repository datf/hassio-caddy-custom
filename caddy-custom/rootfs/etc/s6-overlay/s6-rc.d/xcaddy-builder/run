#!/command/with-contenv bashio
# ==============================================================================
# Build a custom version of caddy with xcaddy and the plugins from the config
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

CUSTOM_CADDY_PATH="${XDG_CONFIG_HOME}/caddy-custom"
TMP_CADDY_BUILD_PATH="/tmp/caddy_new"

LAST_PLUGINS_FILE="${XDG_CONFIG_HOME}/last_plugins.txt"
LAST_CADDY_FILE="${XDG_CONFIG_HOME}/last_caddy_version.txt"

if ! bashio::config.has_value 'plugins'; then
    if [ -f "${CUSTOM_CADDY_PATH}" ]; then
        bashio::log.info "No plugins configured. Removing custom Caddy binary..."
        rm -f "${CUSTOM_CADDY_PATH}" "${LAST_PLUGINS_FILE}" "${LAST_CADDY_FILE}"
        touch /tmp/caddy_hotswap
        bashio::log.info "Restarting Caddy service to revert to vanilla Caddy..."
        s6-svc -r /run/service/caddy-custom
    else
        bashio::log.info "No plugins configured. No build required."
    fi
    exit 0
fi

RESOLUTION_FAILED=false

# Check caddy version upstream
ACTUAL_CADDY_VERSION=$(go list -m -f '{{.Version}}' "github.com/caddyserver/caddy/v2@latest" 2>/dev/null || echo "")
if [ -z "${ACTUAL_CADDY_VERSION}" ]; then
    RESOLUTION_FAILED=true
    bashio::log.warning "Unable to query the latest caddy version."
fi

RESOLVED_PLUGINS=""
XCADDY_ARGS=()

for plugin in $(bashio::config 'plugins'); do
    # Skip if module is a replacement (module=override)
    if [[ "${plugin}" == *"="* ]]; then
        RESOLVED_PLUGINS+="${plugin} "
        XCADDY_ARGS+=("--with" "${plugin}")
        continue
    fi

    module_path="${plugin%%@*}"
    version_spec="${plugin#*@}"

    # Use @latest if no version specified
    if [ "${version_spec}" == "${plugin}" ]; then
        query="${module_path}@latest"
    else
        query="${module_path}@${version_spec}"
    fi

    actual_version=$(go list -m -f '{{.Version}}' "${query}" 2>/dev/null || echo "")

    if [ -n "${actual_version}" ]; then
        target_spec="${module_path}@${actual_version}"
        RESOLVED_PLUGINS+="${target_spec} "
        XCADDY_ARGS+=("--with" "${target_spec}")
    else
        RESOLUTION_FAILED=true
        bashio::log.warning "Could not resolve version for '${plugin}'."
        RESOLVED_PLUGINS+="${plugin} "
        XCADDY_ARGS+=("--with" "${plugin}")
    fi
done

# Trim whitespace
RESOLVED_PLUGINS="$(echo "${RESOLVED_PLUGINS}" | xargs)"
LAST_PLUGINS="$(cat "${LAST_PLUGINS_FILE}" 2>/dev/null || echo "")"
LAST_PLUGINS="$(echo "${LAST_PLUGINS}" | xargs)"

INSTALLED_CADDY_VERSION=""
if [ -f "${CUSTOM_CADDY_PATH}" ]; then
    INSTALLED_CADDY_VERSION=$("${CUSTOM_CADDY_PATH}" version 2>/dev/null | awk '{print $1}')
fi
LAST_CADDY_VERSION=$(cat "${LAST_CADDY_FILE}" 2>/dev/null || echo "")
CURRENT_CADDY="${INSTALLED_CADDY_VERSION:-${LAST_CADDY_VERSION}}"

if [ -f "${CUSTOM_CADDY_PATH}" ]; then
    if [ "${RESOLVED_PLUGINS}" == "${LAST_PLUGINS}" ] && [ -n "${CURRENT_CADDY}" ] && [ "${CURRENT_CADDY}" == "${ACTUAL_CADDY_VERSION}" ]; then
        bashio::log.info "Caddy (${ACTUAL_CADDY_VERSION}) and plugins up to date (${RESOLVED_PLUGINS})."
        exit 0
    elif [ "${RESOLUTION_FAILED}" = true ]; then
        exit 0
    fi
fi

if [ -n "${CURRENT_CADDY}" ] && [ -n "${ACTUAL_CADDY_VERSION}" ] && [ "${CURRENT_CADDY}" != "${ACTUAL_CADDY_VERSION}" ]; then
    bashio::log.info "New version from mainstream (Current: '${CURRENT_CADDY}', Latest: '${ACTUAL_CADDY_VERSION}'). Rebuilding Caddy..."
else
    bashio::log.info "Config or plugin version change detected (Current plugins: '${LAST_PLUGINS}', Target: '${RESOLVED_PLUGINS}'). Building new Caddy binary..."
fi

# Run the build to a temporary location
if xcaddy build ${ACTUAL_CADDY_VERSION:+${ACTUAL_CADDY_VERSION}} --output "${TMP_CADDY_BUILD_PATH}" "${XCADDY_ARGS[@]}"; then
    bashio::log.info "Build successful. Validating configuration..."

    # Export ENV vars before validation, in case the Caddyfile requires them to parse correctly
    for var in $(bashio::config 'env_vars|keys'); do
        export "$(bashio::config "env_vars[${var}].name")"="$(bashio::config "env_vars[${var}].value")"
    done

    # Test the new binary with the current config
    CONFIG_PATH="/etc/caddy/Caddyfile"
    if [ -f "${XDG_CONFIG_HOME}/Caddyfile" ]; then
        CONFIG_PATH="${XDG_CONFIG_HOME}/Caddyfile"
    fi

    if "${TMP_CADDY_BUILD_PATH}" validate --config "${CONFIG_PATH}"; then
        bashio::log.info "Validation passed! Deploying..."

        # Replace the persistent binary and update the state
        mv "${TMP_CADDY_BUILD_PATH}" "${CUSTOM_CADDY_PATH}"
        chmod +x "${CUSTOM_CADDY_PATH}"
        echo "${RESOLVED_PLUGINS}" > "${LAST_PLUGINS_FILE}"
        echo "${ACTUAL_CADDY_VERSION}" > "${LAST_CADDY_FILE}"

        touch /tmp/caddy_hotswap

        bashio::log.info "Restarting Caddy service to load new binary..."
        # Restart with the new binary via s6-rc.d
        s6-svc -r /run/service/caddy-custom
    else
        bashio::log.error "New binary failed validation. Aborting deployment."
        exit 1
    fi
else
    bashio::log.error "xcaddy build failed."
    exit 1
fi

exit 0
